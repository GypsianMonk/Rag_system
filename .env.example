# ════════════════════════════════════════════════════════
#  Enterprise RAG System — Environment Variables
#  Copy to .env and fill in your values.
#  NEVER commit .env to version control.
# ════════════════════════════════════════════════════════

# ── App ──────────────────────────────────────────────────
APP_VERSION=1.0.0
ENVIRONMENT=development          # development | staging | production
DEBUG=true
ALLOWED_ORIGINS=["*"]

# ── LLM Provider ─────────────────────────────────────────
LLM_PROVIDER=openai              # openai | anthropic | ollama
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=2048
LLM_TIMEOUT_SECONDS=60

OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...

# ── Embeddings ───────────────────────────────────────────
EMBEDDING_PROVIDER=huggingface   # huggingface | openai
EMBEDDING_MODEL=BAAI/bge-base-en-v1.5
EMBEDDING_DIMENSION=768
EMBEDDING_BATCH_SIZE=64

# ── Vector Store ─────────────────────────────────────────
VECTOR_STORE=faiss               # faiss | chroma | pinecone | weaviate
FAISS_INDEX_PATH=./data/faiss_index
CHROMA_PERSIST_DIR=./data/chroma

# Pinecone (if VECTOR_STORE=pinecone)
# PINECONE_API_KEY=your-key
# PINECONE_INDEX_NAME=rag-index
# PINECONE_ENVIRONMENT=us-east-1

# ── Retrieval ────────────────────────────────────────────
RETRIEVAL_TOP_K=5
HYBRID_ALPHA=0.5                 # 0.0 = pure BM25, 1.0 = pure dense
RERANKER_ENABLED=true
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANKER_TOP_K=3
HALLUCINATION_THRESHOLD=0.5

# ── Ingestion ────────────────────────────────────────────
CHUNK_SIZE=512
CHUNK_OVERLAP=64
MAX_FILE_SIZE_MB=50
ALLOWED_EXTENSIONS=["pdf","docx","txt","csv","md"]

# ── Database ─────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://rag:rag@localhost:5432/ragdb

# ── Redis ────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
CACHE_TTL_SECONDS=3600
CACHE_ENABLED=true

# ── Auth ─────────────────────────────────────────────────
JWT_SECRET_KEY=super-secret-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
AUTH_ENABLED=false

# ── Rate Limiting ─────────────────────────────────────────
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60
